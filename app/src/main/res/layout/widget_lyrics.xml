<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/panel_bg" />

    <!-- Sin música: reloj y fecha. TextClock se actualiza solo, sin despertar a la app. -->
    <LinearLayout
        android:id="@+id/clock_box"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextClock
            android:id="@+id/clock_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:textColor="#FFFFFFFF"
            android:textSize="44sp" />

        <TextClock
            android:id="@+id/clock_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:format12Hour="EEEE, d 'de' MMMM"
            android:format24Hour="EEEE, d 'de' MMMM"
            android:textColor="#B3FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lyrics_box"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="12dp">

        <!-- Cabecera: canción (abre el reproductor) y ajuste de desfase. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/track"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/offset_minus"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@string/cd_offset_minus"
                android:padding="7dp"
                android:src="@drawable/ic_remove" />

            <TextView
                android:id="@+id/offset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="40dp"
                android:gravity="center"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp" />

            <ImageView
                android:id="@+id/offset_plus"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@string/cd_offset_plus"
                android:padding="7dp"
                android:src="@drawable/ic_add" />
        </LinearLayout>

        <!--
            Líneas de la letra. Dos caras iguales: el widget escribe la línea nueva en la cara
            oculta y pasa a ella, y el lanzador anima el cambio deslizando hacia arriba.
            Tocar abre la letra completa (o la app si no se encontró).
        -->
        <ViewFlipper
            android:id="@+id/lines"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:animateFirstView="false"
            android:inAnimation="@anim/line_in"
            android:outAnimation="@anim/line_out">

            <LinearLayout
                android:id="@+id/face_a"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingEnd="8dp">
    
                <TextView
                    android:id="@+id/prev_a"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#66FFFFFF" />
    
                <TextView
                    android:id="@+id/current_a"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="#FFFFFFFF"
                    android:textStyle="bold" />
    
                <TextView
                    android:id="@+id/next_a"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#99FFFFFF" />
    
                <TextView
                    android:id="@+id/next2_a"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#66FFFFFF" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/face_b"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingEnd="8dp">
    
                <TextView
                    android:id="@+id/prev_b"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#66FFFFFF" />
    
                <TextView
                    android:id="@+id/current_b"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="#FFFFFFFF"
                    android:textStyle="bold" />
    
                <TextView
                    android:id="@+id/next_b"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#99FFFFFF" />
    
                <TextView
                    android:id="@+id/next2_b"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#66FFFFFF" />
            </LinearLayout>
        </ViewFlipper>

        <!-- Avance de la canción; se muestra la variante que contrasta con el fondo elegido. -->
        <ProgressBar
            android:id="@+id/progress_light"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:max="1000"
            android:progressDrawable="@drawable/progress_light" />

        <ProgressBar
            android:id="@+id/progress_dark"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:max="1000"
            android:progressDrawable="@drawable/progress_dark"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
