    <!-- Ayuda -->
    <string name="section_help">Cómo usarla</string>
    <string name="help_text">1. Concede el acceso a la música.\n2. Mantén presionado un espacio vacío del escritorio → Widgets → LyricWidget.\n3. Pon música: la letra avanza sola. Toca el título del widget para abrir el reproductor y la letra para verla completa.</string>
    <string name="credits">Letras de LRCLIB (lrclib.net) y lyrics.ovh, APIs públicas y gratuitas.</string>
