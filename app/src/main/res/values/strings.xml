    <!-- Acceso -->
    <string name="section_access">Acceso a la música</string>
    <string name="access_hint">Para saber qué suena en Spotify, YouTube Music y otras apps, Android pide el acceso a notificaciones. La app no lee ni guarda tus notificaciones: solo la canción en reproducción.</string>
    <string name="access_ok">Acceso concedido</string>
    <string name="access_missing">Falta conceder el acceso</string>
    <string name="access_grant">Conceder acceso</string>
    <string name="restricted_title">¿Dice «Configuración restringida»?</string>
    <string name="restricted_steps">Android bloquea este permiso en las apps instaladas desde un archivo APK. Para desbloquearlo:\n1. Toca «Abrir información de la app».\n2. Toca el menú ⋮ (arriba a la derecha) → «Permitir configuración restringida» y confirma.\n3. Vuelve aquí y toca «Conceder acceso».</string>
    <string name="restricted_open">Abrir información de la app</string>

