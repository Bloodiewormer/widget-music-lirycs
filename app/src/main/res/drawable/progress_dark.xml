<?xml version="1.0" encoding="utf-8"?>
<!-- Barra de avance del widget. Hay una versión clara y otra oscura porque antes de Android 12
     un widget no puede teñir un ProgressBar en tiempo de ejecución. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <solid android:color="#33202124" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <solid android:color="#CC202124" />
                <corners android:radius="2dp" />
            </shape>
        </clip>
    </item>
</layer-list>
